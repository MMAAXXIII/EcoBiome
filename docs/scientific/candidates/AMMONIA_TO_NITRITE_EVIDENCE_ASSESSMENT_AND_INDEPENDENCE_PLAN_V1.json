{
  "plan_payload": {
    "assessment_policy": {
      "append_only_supersession": true,
      "one_assessment_per_reviewed_assertion_claim_link": true,
      "policy_name": "ecobiome-evidence-assessment",
      "policy_version": "1-candidate",
      "required_dimensions": {
        "endpoint_or_response_json": {
          "required": true,
          "state_at_rate_2m": "unresolved"
        },
        "evidence_directness": {
          "instruction": "Assess how directly the cited evidence establishes the target assertion. Do not upgrade author_interpretation to direct measurement without source-level proof.",
          "state_at_rate_2m": "unresolved"
        },
        "limitations_json": {
          "must_include": [
            "source_scope_broader_than_target_assertion",
            "support_mode_author_interpretation"
          ],
          "state_at_rate_2m": "required"
        },
        "methodological_dimensions_json": {
          "must_record": [
            "sample_origin",
            "experimental_unit",
            "measurement_methods",
            "controls_or_comparators",
            "replication",
            "analysis_pipeline"
          ],
          "state_at_rate_2m": "unresolved"
        },
        "statistical_result_json": {
          "instruction": "Use kind=not_applicable only after confirming that no inferential/statistical result is relevant to the specific support claim; missing review is not N/A.",
          "state_at_rate_2m": "unresolved"
        },
        "study_design": {
          "instruction": "Classify from source methods/results, not from article title, journal prestige, or support link label.",
          "state_at_rate_2m": "unresolved"
        },
        "study_scope_json": {
          "must_record": [
            "organism_or_community",
            "environment_or_matrix",
            "experimental_system",
            "target_process_scope",
            "source_broader_than_assertion"
          ],
          "state_at_rate_2m": "unresolved"
        }
      }
    },
    "forbidden_at_rate_2m": {
      "evidence_assessment_insert": true,
      "knowledge_synthesis_insert": true,
      "numeric_rate_model": true,
      "process_scientific_support_materialization": true,
      "real_v6_write": true,
      "remote_write": true,
      "source_lineage_edge_insert": true
    },
    "gate": "ECOBIOME_G7A_RATE_2M_EVIDENCE_ASSESSMENT_AND_INDEPENDENCE_DESIGN_LOCAL_R2",
    "human_review_boundary": {
      "assessment_candidates_attachable_now": false,
      "independence_decision_completed": false,
      "next_human_review_required": true
    },
    "independence_policy": {
      "candidate_vocabulary": [
        "unresolved",
        "dependent",
        "partially_independent",
        "independent"
      ],
      "independent_support_origin_count": null,
      "initial_status_for_both_links": "unresolved",
      "known_rate_2m_fact": {
        "effect": "automatic independent_support_origin_count=2 remains forbidden",
        "shared_authors": [
          "Mads Albertsen",
          "Per H. Nielsen"
        ]
      },
      "physical_db_enum_detected": false,
      "policy_name": "ecobiome-evidence-origin-independence",
      "policy_version": "1-candidate",
      "required_pairwise_dimensions": [
        "author_overlap",
        "institution_or_lab_overlap",
        "sample_or_specimen_overlap",
        "dataset_overlap",
        "experimental_system_overlap",
        "analysis_pipeline_overlap",
        "direct_source_lineage",
        "cross_citation_or_declared_coordination",
        "shared_funding_or_project_context_when_relevant"
      ],
      "rules": [
        {
          "id": "distinct_identifier_not_sufficient",
          "rule": "Distinct DOI/PMCID records do not by themselves prove independent scientific support."
        },
        {
          "id": "author_overlap_not_sufficient_for_dependence",
          "rule": "Shared authorship blocks automatic independence but does not by itself prove that the evidence origins are dependent."
        },
        {
          "id": "direct_lineage_is_dependency_evidence",
          "rule": "Explicit source lineage, reuse of the same experimental dataset/sample set, or direct derivative analysis is positive evidence of dependence."
        },
        {
          "id": "independence_requires_origin_separation",
          "rule": "Independent status requires affirmative evidence that the relevant support arises from distinct underlying samples/data and sufficiently separate experimental or analytical origins."
        },
        {
          "id": "unknown_remains_unresolved",
          "rule": "Missing metadata cannot be converted into independence."
        }
      ]
    },
    "next_gate": "RATE-2N_PRIMARY_SOURCE_EVIDENCE_ASSESSMENT_CANDIDATE_EXTRACTION",
